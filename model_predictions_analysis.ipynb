    "data = data.sort_values(by = ['sum'], ascending = False)\n",
    "long_df = data.head(10).melt(\n",
    "        id_vars=['слово'],\n",
    "        value_vars=['Negative', 'Positive', 'Neutral'],\n",
    "        var_name='Тональность',\n",
    "        value_name='Количество упоминаний'\n",
    "    )\n",
    "long_df = long_df.reset_index(drop=True)\n",
    "long_df = long_df.rename(columns = {'слово': 'Аспекты'})"
