    "df = pd.read_excel("datasets/reviews_with_sentiment_aspects.xlsx")\n",
    "def quick_metrics(df, true_col='overall', pred_col='общая_тональность'):\n",
    "\n",
    "    \"\"\"\n",
    "    Расчет метрик классификации для общей тональности отзыва\n",
    "    \"\"\"\n",
    "    y_true = df[true_col]\n",
    "    y_pred = df[pred_col]\n",
    "    categories = ['Positive', 'Negative', 'Neutral']\n",
    "    \n",
    "    accuracy = round(accuracy_score(y_true, y_pred), 3)\n",
    "    precision = [round(p, 3) for p in precision_score(y_true, y_pred, average=None, labels=categories, zero_division=0)]\n",
    "    recall = [round(r, 3) for r in recall_score(y_true, y_pred, average=None, labels=categories, zero_division=0)]\n",
    "    print(f'Точность модели: {accuracy}')\n",
    "    results = pd.DataFrame({\n",
    "        'Категория': categories,\n",
    "        'Precision': precision,\n",
    "        'Recall': recall\n",
    "    })\n",
    "    \n",
    "    return results\n",
    "\n",
    "# Вызов функции\n",
    "quick_metrics(df)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "55152164",
   "metadata": {},
   "source": [
    "### Предобработка датасета для выявления и анализа наиболее популярных аспектов тональности"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f1cc7585",
   "metadata": {},
   "source": [
    "#### Основные этапы обработки\n",
    "\n",
    "#### 1. Нормализация текста\n",
    "- Очистка от лишних символов (точки, запятые, тире)\n",
    "- Группировка по ключевым словам (врач, персонал, лечение и т.д.). Было замечено, что многие одинаковые слова встречаются в разных словосочетаниях или с ошибками, поэтому для них был составлен отдельный список ключевых слов, чтобы сократить итоговое число аспектов \n",
    "\n",
    "#### 2. Лемматизация\n",
    "- Использование pymorphy3 для приведения слов к нормальной форме\n",
    "- Учет длины слов (пропуск коротких слов < 3 символов)\n",
    "\n",
    "#### 3. Извлечение данных\n",
    "- Удаление блоков с уверенностью за ненадобностью\n",
    "- Поиск паттерна: `аспект: Positive/Negative/Neutral` для выделения аспекта\n",
    "- Очистка от знаков препинания по краям слов\n",
    "\n",
    "#### 4. Структурирование результатов\n",
    "- Создание отдельных DataFrame для каждой тональности\n",
    "- Подсчет частоты упоминаний аспектов\n",
    "На выходе получаются три таблицы:\n",
    "- `positive_df` - положительные аспекты\n",
    "- `neutral_df` - нейтральные аспекты  \n",
    "- `negative_df` - отрицательные аспекты"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9d0a379b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def normalize_with_keywords(text):\n",
    "\n",
    "    \"\"\"\n",
    "    Нормализует текст (слово или словосочетание): если содержит ключевое слово, заменяет на него\n",
    "    \"\"\"\n",
    "\n",
    "    # Сначала базовая очистка\n",
    "    cleaned_text = re.sub(r'[\\.\\-,;]', ' ', text)\n",
    "    cleaned_text = re.sub(r'\\s+', ' ', cleaned_text).strip()\n",
    "    text_lower = cleaned_text.lower()\n",
    "    \n",
    "    # Ключевые слова для группировки\n",
    "    keywords = ['врач', 'персонал', 'клиник', 'стоматолог', 'лечение', \n",
    "                'обслуживание', 'качество', 'цена', 'стоимость', 'отношение', 'сестр', \n",
    "                'прием', 'приём', 'палат', 'подход', 'гардероб', 'кабинет', 'линия', 'департамент',\n",
    "                'заведовать', 'коллектив', 'отделение', 'аппарат', 'больни', 'поликлин', 'руковод']\n",
    "    \n",
    "    # Ищем ключевые слова\n",
    "    for keyword in keywords:\n",
    "        if keyword in text_lower:\n",
    "            return keyword\n",
    "    \n",
    "    # Если не нашли ключевых слов, возвращаем первое слово\n",
    "    words = text_lower.split()\n",
    "    if words:\n",
    "        return words[0]\n",
    "    \n",
    "    return cleaned_text\n",
    "\n",
    "def process_text_with_lemmatization_and_keywords(text_series):\n",
    "\n",
    "    \"\"\"\n",
    "    Полная обработка текста: очистка → лемматизация → группировка по ключевым словам\n",
    "    \"\"\"\n",
    "\n",
    "    # Инициализация лемматизатора\n",
    "    morph = pymorphy3.MorphAnalyzer()\n",
    "    \n",
    "    def lemmatize_text(word):\n",
    "\n",
    "        \"\"\"Лемматизация слова или словосочетания\"\"\"\n",
    "\n",
    "        if ' ' in word:\n",
    "            words = word.split()\n",
    "            lemmatized_words = []\n",
    "            for w in words:\n",
    "                if len(w) > 2:  # Пропускаем короткие слова\n",
    "                    parsed = morph.parse(w)[0]\n",
    "                    lemmatized_words.append(parsed.normal_form)\n",
    "                else:\n",
    "                    lemmatized_words.append(w)\n",
    "            return ' '.join(lemmatized_words)\n",
    "        else:\n",
    "            if len(word) > 2:\n",
    "                parsed = morph.parse(word)[0]\n",
    "                return parsed.normal_form\n",
    "            else:\n",
    "                return word\n",
    "    \n",
    "    # Паттерны для очистки\n",
    "    confidence_pattern = r'\\s*\\(увер\\.\\s*\\d+\\.\\d+\\)' # Убрать уверенность модели\n",
    "    sentiment_pattern = r'([^:]+):\\s*(Positive|Neutral|Negative)' # Разделить категорию тональности и аспект\n",
    "    punctuation_pattern = r'^[;,.():\\s]+|[;,.():\\s]+$' # Убрать знаки препинания, если есть\n",
    "    \n",
    "    sentiment_data = defaultdict(list)\n",
    "    \n",
    "    for text in text_series.dropna():\n",
    "        # Удаляем блоки с уверенностью\n",
    "        cleaned_text = re.sub(confidence_pattern, '', text)\n",
    "        \n",
    "        # Извлекаем слова и тональность\n",
    "        matches = re.findall(sentiment_pattern, cleaned_text)\n",
    "        for word, sentiment in matches:\n",
    "            # Очищаем слово от знаков препинания по краям\n",
    "            clean_word = re.sub(punctuation_pattern, '', word.strip())\n",
    "            clean_word = re.sub(r'\\s+', ' ', clean_word)\n",
    "            \n",
    "            if clean_word:\n",
    "                # 1. Сначала лемматизируем\n",
    "                lemmatized_word = lemmatize_text(clean_word)\n",
    "                \n",
    "                # 2. Затем применяем группировку по ключевым словам\n",
    "                final_word = normalize_with_keywords(lemmatized_word)\n",
    "                \n",
    "                sentiment_data[sentiment].append(final_word)\n",
    "    \n",
    "    return sentiment_data\n",
    "sentiment_data = process_text_with_lemmatization_and_keywords(df['аспектный_анализ'])\n",
    "\n",
    "def create_sentiment_dataframes(sentiment_data):\n",
    "\n",
    "    \"\"\"\n",
    "    Создает отдельные датафреймы для каждой тональности\n",
    "    \"\"\"\n",
    "\n",
    "    dataframes = {}\n",
    "    \n",
    "    for sentiment in ['Positive', 'Neutral', 'Negative']:\n",
    "        if sentiment in sentiment_data and sentiment_data[sentiment]:\n",
    "            # Создаем временный DataFrame\n",
    "            df_temp = pd.DataFrame(sentiment_data[sentiment], columns=['слово'])\n",
    "            \n",
    "            # Считаем количество упоминаний\n",
    "            df_count = df_temp['слово'].value_counts().reset_index()\n",
    "            df_count.columns = ['слово', 'число_упоминаний']\n",
    "            \n",
    "            # Сортируем по убыванию количества упоминаний\n",
    "            df_count = df_count.sort_values('число_упоминаний', ascending=False)\n",
    "            \n",
    "            dataframes[sentiment.lower()] = df_count\n",
    "        else:\n",
    "            # Создаем пустой DataFrame если нет данных\n",
    "            dataframes[sentiment.lower()] = pd.DataFrame(columns=['слово', 'число_упоминаний'])\n",
    "    \n",
    "    return dataframes\n",
    "\n",
    "sentiment_dfs = create_sentiment_dataframes(sentiment_data)\n",
    "\n",
    "# Извлекаем отдельные датафреймы\n",
    "positive_df = sentiment_dfs['positive']\n",
    "neutral_df = sentiment_dfs['neutral']\n",
    "negative_df = sentiment_dfs['negative']"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "700a0e55",
   "metadata": {},
   "source": [
    "### Далее создаем сводную таблицу для упрощения анализа"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e95bb62f",
   "metadata": {},
   "outputs": [],
   "source": [
    "positive_df['тональность'] = 'Positive'\n",
    "negative_df['тональность'] = 'Negative'\n",
    "neutral_df['тональность'] = 'Neutral'\n",
    "# Объединяем датасеты\n",
    "combined_df = pd.concat([positive_df, negative_df, neutral_df], axis=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ebe51bdb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Создаем сводную таблицу\n",
    "pivot_df = combined_df.pivot_table(\n",
    "    index='слово',\n",
    "    columns='тональность', \n",
    "    values='число_упоминаний',\n",
    "    fill_value=0,\n",
    "    aggfunc='sum'\n",
    ").reset_index()\n",
    "pivot_df.columns.name = None\n",
    "for sentiment in ['Positive', 'Negative', 'Neutral']:\n",
    "    if sentiment not in pivot_df.columns:\n",
    "        pivot_df[sentiment] = 0\n",
    "pivot_df = pivot_df[['слово', 'Negative', 'Positive', 'Neutral']]"
   ]
  },
